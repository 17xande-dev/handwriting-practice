{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "tasks": {
    "bundle": "deno bundle --platform=browser --minify --output=internal/handler/static/app.js web/main.ts",
    "check": "deno check web/",
    "test": "deno test web/"
  },
  "fmt": {
    "include": ["web/"],
    "lineWidth": 100
  },
  "lint": {
    "include": ["web/"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}
