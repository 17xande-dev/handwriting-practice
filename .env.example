# Optional Compose settings; copy to .env for local development.
# Use true for HTTPS. Never use false on a public deployment.
COOKIE_SECURE=false
# Optional exact browser origin (lowercase, no trailing slash or default port).
BASE_URL=http://localhost:8083

# Positive whole-second Go durations; use hours for days. Idle cannot exceed absolute.
SESSION_IDLE=720h
SESSION_ABSOLUTE=2160h
DEVICE_SESSION_IDLE=2160h
DEVICE_SESSION_ABSOLUTE=8760h
HSTS=false
# Leave unset unless every request arrives through a proxy that sets the header.
CLIENT_IP_HEADER=
# Server listen address, SQLite file and shutdown wait; Compose sets the first two.
# ADDR=:8080
# DB_PATH=/data/handwriting.db
# SHUTDOWN_TIMEOUT=10s
